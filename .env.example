NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable ("anon") key — safe to commit, not a secret. Required
# by userDb() (packages/db/src/user-client.ts), which every page under
# [accountId]/ and all 18 in-account server actions route through as of M2.
# Missing this 500s the entire in-account CRM, agency included, while
# /dashboard/accounts and /dashboard/blueprints (still on serviceDb()) keep
# working — easy to misread as "the CRM is broken" rather than a missing var.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_h2GmSCjLzD74RotkQAvMbA_BL6FAI4k
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# M1b messaging. Sending is FAKE everywhere except VERCEL_ENV=production.
RESEND_API_KEY=
EMAIL_FROM=crm@bis-rgv.com
# Optional, non-production only: forces real sends but rewrites every
# recipient to this one address. Never set this to a contact's real address.
EMAIL_DEV_REDIRECT_TO=
RESEND_WEBHOOK_SECRET=
