# Clerk. Both keys must come from the SAME instance — a mismatched pair fails
# at sign-in itself. `pk_test_`/`sk_test_` is a development instance, which is
# what production still runs on: that is where the "(dev)" in the app name and
# the un-disableable Development-mode banner on /sign-in come from, and no
# styling reaches either. See docs/runbooks/clerk-setup.md before switching to
# a `pk_live_` pair — the instance also owns the session-token customization
# (`org_id`, `role`, `app_role`) that app.is_agency() and
# app.current_account_id() read, and a default token makes every RLS-gated
# query return ZERO ROWS instead of erroring.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable ("anon") key — safe to commit, not a secret. Required
# by userDb() (packages/db/src/user-client.ts), which every page under
# [accountId]/ and all 18 in-account server actions route through as of M2.
# Missing this 500s the entire in-account CRM, agency included, while
# /dashboard/accounts and /dashboard/blueprints (still on serviceDb()) keep
# working — easy to misread as "the CRM is broken" rather than a missing var.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_h2GmSCjLzD74RotkQAvMbA_BL6FAI4k
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# M1b messaging. Sending is FAKE everywhere except VERCEL_ENV=production.
RESEND_API_KEY=
EMAIL_FROM=crm@bis-rgv.com
# Optional, non-production only: forces real sends but rewrites every
# recipient to this one address. Never set this to a contact's real address.
EMAIL_DEV_REDIRECT_TO=
RESEND_WEBHOOK_SECRET=
# Absolute origin for links inside outbound email (and dashboard links in
# alerts). Set to the custom domain; when unset, links derive from the
# triggering request — which for cron/webhook invocations is the vercel.app
# deployment URL, the exact link/sender mismatch Gmail silently discards.
APP_ORIGIN=https://app.bis-rgv.com

# Voice Receptionist (M-voice-core). Setup runbook: docs/runbooks/voice-setup.md
# — walk it in order; step 6 is a real phone call, not optional.

# The three REQUIRED vars — voice answers zero calls without all three set in
# Vercel Production. ⚠️ Vercel silently no-ops "Add New" on an existing name:
# Remove-then-Add, then redeploy (env changes need a fresh deploy to apply).
# Sensitive in Vercel — an OpenAI API key scoped to a dedicated
# "BIS Platform Voice" project (never share it with another OpenAI project).
OPENAI_API_KEY=
# Sensitive in Vercel — the whsec_… signing secret from that same project's
# Settings > Webhooks > realtime.call.incoming endpoint. Requests that fail
# this verification are rejected with 400 before anything else runs.
OPENAI_WEBHOOK_SECRET=
# Not sensitive — the proj_… id of that dedicated OpenAI project. Embedded
# directly into the SIP URI the TeXML route hands Telnyx
# (sip:<this>@sip.api.openai.com;transport=tls), so a typo here fails EVERY
# call, not just voice's own webhook.
VOICE_OPENAI_PROJECT_ID=
# Not sensitive — Ed25519 public key (base64, raw 32 bytes) from the Telnyx
# portal: Keys & Credentials > Public Key. Unset = signature validation OFF
# (today's behavior, no auth on the TeXML route). Once set, every POST must
# carry a valid telnyx-signature-ed25519 + telnyx-timestamp pair or gets
# 403, and GET (the unauthenticated diagnostic path) starts returning 405 —
# set this ONLY after flipping the TeXML app's Voice Method to POST
# (docs/runbooks/voice-setup.md) and making a verified test call. Rollback:
# remove the key.
TELNYX_PUBLIC_KEY=

# Everything below is OPTIONAL — each ships with a default judged right on
# real test calls (see the runbook's Step 6). Only set one after a real call
# revealed a concrete reason to; these are tuning knobs, not config required
# to go live.

# Realtime model id. Default: gpt-realtime.
REALTIME_MODEL=
# Delay before the greeting plays, milliseconds. OpenAI's SIP accept returns
# once the leg is RINGING, not once media is flowing — sending audio
# immediately clips its first syllable. Default: 900.
PHONE_GREETING_DELAY_MS=
# Hard cap on call length, seconds, before Sofía is told to wrap up. Clamped
# to 10-750 regardless of this value. The 750 ceiling is the route's own
# maxDuration of 800s, and
# the budget has two halves the cap's own clock cannot see: roughly 30s of
# tail after it fires (the goodbye playing out, the bounded frame drain, the
# carrier text-back, and finishCall's remaining DB and email round trips) plus
# roughly 20s of connect leg before the cap timer is armed at all. The 10s
# FLOOR exists so the silent-call window below — half of this number — can
# never fall under its own 5s minimum and cut a caller off before the greeting
# has even played. Default: 240.
PHONE_MAX_CALL_SECONDS=
# How long a call may produce NO caller audio at all before it is ended,
# seconds. This number is clamped to 5-120, but the window actually armed is
# the SMALLER of it and half of PHONE_MAX_CALL_SECONDS — so tightening the cap
# below this number can never invert the two: a silent call always ends on this
# guard's fixed goodbye, and never on the cap's open-ended one. That window is
# never under 5 seconds whatever either knob is set to, because the cap itself
# is floored at 10, so the greeting has always finished before this can fire.
# The cost guardrail above bounds a call that is going somewhere; this one
# bounds a call that is not — a robot that connects and says nothing billed the
# full PHONE_MAX_CALL_SECONDS before this existed. The first sound the caller
# makes cancels it for the rest of the call, but that sound has to arrive
# inside the window: someone who stays silent past it and speaks up afterwards
# still gets the goodbye, because by then the call is already ending.
# Default: 30.
PHONE_MAX_SILENT_SECONDS=
# How long to wait for the realtime WS to actually open before giving up on
# the call, milliseconds. Clamped to the 1000-60000 range. Default: 15000.
PHONE_CONNECT_TIMEOUT_MS=
# "server" switches turn-detection from the default semantic_vad to
# server_vad (the three PHONE_VAD_* knobs below only apply in that mode).
# Any other value (including unset) keeps semantic_vad. Default: unset
# (semantic_vad).
PHONE_TURN_DETECTION=
# semantic_vad eagerness: low | medium | high | auto. Ported tuning history:
# server_vad@500ms interrupted callers, semantic/low paused too long —
# semantic/medium is what danlo judged right on real calls. Default: medium.
PHONE_VAD_EAGERNESS=
# server_vad only. Speech-detection sensitivity, 0-1 (clamped). Default: 0.6.
PHONE_VAD_THRESHOLD=
# server_vad only. Audio included before detected speech, milliseconds
# (clamped 0-2000). Default: 300.
PHONE_VAD_PREFIX_PADDING_MS=
# server_vad only. Silence duration that ends a turn, milliseconds (clamped
# 200-4000). Default: 800.
PHONE_VAD_SILENCE_MS=
# Abuse-cap ceilings, counted from PRIOR calls today (UTC day) — the Nth call
# is declined once N-1 priors already hit the ceiling. Per calling number,
# per day. Default: 5.
PHONE_MAX_CALLS_PER_NUMBER_PER_DAY=
# Per account, per day. Default: 50.
PHONE_MAX_CALLS_PER_ACCOUNT_PER_DAY=
# Refuse a caller whose whole recent history on this account is silent calls,
# before the call is ever bridged to the model. Blocks only when EVERY call in
# the window classified spam AND at least this many did — one booking, lead,
# message or even one call where a human spoke clears the caller completely.
# Default: 3.
PHONE_SPAM_BLOCK_THRESHOLD=
# How far back that history is read, days. Rolling, so a block expires on its
# own: a refused call writes no row, so a blocked caller could otherwise never
# earn their way back. Default: 30.
PHONE_SPAM_BLOCK_WINDOW_DAYS=

# Video meetings (Daily.co). Dashboard → Developers → API keys. Unset = video
# calendars book without meeting links (the abstraction stays dormant; no
# error, no fake provider — see apps/web/src/lib/meetings/provider.ts).
# Sensitive in Vercel.
DAILY_API_KEY=

# "Talk to Sofía" on the marketing website (apps/web/src/app/api/voice/web/
# session). All four must be set for the button to work; any one missing and
# the route returns 503 and the website renders its "call us instead"
# fallback — it never falls back to a different persona.
#
# Exact origins allowed to open a session, comma-separated. Compared whole
# (scheme, host, port), never by suffix.
SOFIA_WEB_ORIGINS=https://bis-rgv.com,https://www.bis-rgv.com
# Shared with the WEBSITE, which mints the signed ticket that authorizes a
# session after its own bot check and rate limit pass. Any long random
# string; must be byte-identical in both projects. Sensitive in Vercel.
SOFIA_WEB_SECRET=
# The published number whose tenant Sofía answers as here — the same E164 the
# phone path resolves, so the website demo cannot drift onto another account.
SOFIA_WEB_NUMBER=
# How that number is spoken/printed to a visitor who asks how to reach a
# human. Optional; omitted from her instructions when unset.
SOFIA_WEB_DISPLAY_NUMBER=(956) 506-1545

# Operator override: send every call on the voice line to a human instead of
# to Sofía, for as long as this is set. Telnyx REFUSES its own per-number call
# forwarding on a TeXML-utilizing number and points you at TeXML instead —
# this is that. Set it, redeploy, take the call, then REMOVE it and redeploy
# again. Every forwarded call logs "texml FORWARDING to …" so a line left
# pointed at somebody's mobile is visible in the runtime logs.
#
# Bypasses the routability and daily-cap checks on purpose: if a human has
# taken the line back, a cap must not swallow the call they are waiting for.
VOICE_FORWARD_TO=

# Website traffic (docs/runbooks/website-setup.md, Part A): a TEAM-scoped
# Vercel token and the team id, read lazily by the siteTraffic cron pass and
# by Settings → Website. Unset: the pass counts each linked site as failed and
# the card lists no projects; nothing 500s.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
# Where a CLIENT's "Ask BIS about a website" button mails while no site is
# linked. Falls back to hello@bis-rgv.com in code.
AGENCY_SUPPORT_EMAIL=
