{
  "name": "@bis/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./search-term": "./src/search-term.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:push:ci": "tsx src/ci/push-run.ts push",
    "db:migrations:ci": "tsx src/ci/push-run.ts list",
    "ci:sql": "tsx src/ci/sql-run.ts",
    "ci:seed": "tsx src/ci-seed/run.ts",
    "db:seed-demo": "tsx src/demo/run.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "supabase": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8"
  }
}
